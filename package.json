{
  "name": "broke-code",
  "displayName": "broke-code",
  "description": "%extension.description%",
  "version": "0.0.0",
  "publisher": "schalappe",
  "license": "MIT",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/schalappe/broke-code"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "broke-code",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "broke-code.focusChat",
        "key": "ctrl+cmd+b"
      }
    ],
    "views": {
      "broke-code": [
        {
          "type": "webview",
          "id": "brokeCode.chat",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "broke-code.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.addProvider",
        "title": "%command.addProvider.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.generateCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "broke-code",
        "icon": "$(sparkle)"
      },
      {
        "command": "broke-code.addSelectionToChat",
        "title": "%command.addSelectionToChat.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.editSelection",
        "title": "%command.editSelection.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.refactorSelection",
        "title": "%command.refactorSelection.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.documentSelection",
        "title": "%command.documentSelection.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.typeSelection",
        "title": "%command.typeSelection.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.acceptEdit",
        "title": "%command.acceptEdit.title%",
        "category": "broke-code",
        "icon": "$(check)"
      },
      {
        "command": "broke-code.rejectEdit",
        "title": "%command.rejectEdit.title%",
        "category": "broke-code",
        "icon": "$(close)"
      },
      {
        "command": "broke-code.fixDiagnostic",
        "title": "%command.fixDiagnostic.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.acceptChange",
        "title": "%command.acceptChange.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.runCommand",
        "title": "%command.runCommand.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.reject",
        "title": "%command.reject.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.showChange",
        "title": "%command.showChange.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.stop",
        "title": "%command.stop.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.newChat",
        "title": "%command.newChat.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.focusChat",
        "title": "%command.focusChat.title%",
        "category": "broke-code"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "broke-code.fixDiagnostic",
          "when": "false"
        },
        {
          "command": "broke-code.acceptEdit",
          "when": "false"
        },
        {
          "command": "broke-code.rejectEdit",
          "when": "false"
        },
        {
          "command": "broke-code.acceptChange",
          "when": "broke-code.approval == write"
        },
        {
          "command": "broke-code.runCommand",
          "when": "broke-code.approval == command"
        },
        {
          "command": "broke-code.reject",
          "when": "broke-code.approval == write || broke-code.approval == command"
        },
        {
          "command": "broke-code.showChange",
          "when": "broke-code.approval == write"
        },
        {
          "command": "broke-code.stop",
          "when": "broke-code.replying"
        },
        {
          "command": "broke-code.newChat",
          "when": "broke-code.hasEntries"
        }
      ],
      "editor/context": [
        {
          "submenu": "broke-code.editor",
          "when": "editorHasSelection",
          "group": "broke-code"
        }
      ],
      "broke-code.editor": [
        {
          "command": "broke-code.addSelectionToChat",
          "group": "broke-code@1"
        },
        {
          "command": "broke-code.editSelection",
          "when": "!editorReadonly",
          "group": "broke-code@2"
        },
        {
          "command": "broke-code.refactorSelection",
          "when": "!editorReadonly",
          "group": "broke-code@3"
        },
        {
          "command": "broke-code.documentSelection",
          "when": "!editorReadonly",
          "group": "broke-code@4"
        },
        {
          "command": "broke-code.typeSelection",
          "when": "!editorReadonly",
          "group": "broke-code@5"
        }
      ],
      "editor/title": [
        {
          "command": "broke-code.acceptEdit",
          "when": "resourceScheme == broke-code-edit",
          "group": "navigation@1"
        },
        {
          "command": "broke-code.rejectEdit",
          "when": "resourceScheme == broke-code-edit",
          "group": "navigation@2"
        }
      ],
      "scm/title": [
        {
          "command": "broke-code.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "submenus": [
      {
        "id": "broke-code.editor",
        "label": "broke-code"
      }
    ],
    "configuration": {
      "title": "broke-code",
      "properties": {
        "brokeCode.providers": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "%config.providers.description%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "baseUrl"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.providers.name.description%"
              },
              "baseUrl": {
                "type": "string",
                "description": "%config.providers.baseUrl.description%"
              },
              "caFile": {
                "type": "string",
                "markdownDescription": "%config.providers.caFile.description%"
              }
            }
          }
        },
        "brokeCode.contextSizes": {
          "type": "object",
          "scope": "application",
          "default": {},
          "markdownDescription": "%config.contextSizes.description%",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "brokeCode.maxToolSteps": {
          "type": "integer",
          "scope": "application",
          "default": 50,
          "minimum": 1,
          "markdownDescription": "%config.maxToolSteps.description%"
        },
        "brokeCode.autoCompact": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "%config.autoCompact.description%"
        },
        "brokeCode.autoApproveWrites": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "%config.autoApproveWrites.description%"
        },
        "brokeCode.commandTimeoutSeconds": {
          "type": "integer",
          "scope": "application",
          "default": 120,
          "minimum": 1,
          "markdownDescription": "%config.commandTimeoutSeconds.description%"
        },
        "brokeCode.notifications": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "markdownDescription": "%config.notifications.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "eval": "bun run eval/bench.ts",
    "lint": "bunx --bun biome check .",
    "format": "bunx --bun biome check --write .",
    "package": "bun run build && bunx --bun vsce package ${VERSION:-0.0.0} --no-update-package-json --no-git-tag-version --no-dependencies --out broke-code-${VERSION:-0.0.0}.vsix"
  },
  "dependencies": {
    "@vscode/l10n": "0.0.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "ovsx": "1.3.0",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5"
  }
}

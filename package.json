{
  "name": "broke-code",
  "displayName": "broke-code",
  "description": "%extension.description%",
  "version": "0.0.0",
  "publisher": "schalappe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/schalappe/broke-code"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "broke-code",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "broke-code": [
        {
          "type": "webview",
          "id": "brokeCode.chat",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "broke-code.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "broke-code"
      },
      {
        "command": "broke-code.generateCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "broke-code",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "broke-code.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "broke-code",
      "properties": {
        "brokeCode.providers": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "%config.providers.description%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "baseUrl"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.providers.name.description%"
              },
              "baseUrl": {
                "type": "string",
                "description": "%config.providers.baseUrl.description%"
              },
              "caFile": {
                "type": "string",
                "markdownDescription": "%config.providers.caFile.description%"
              }
            }
          }
        },
        "brokeCode.contextSizes": {
          "type": "object",
          "scope": "application",
          "default": {},
          "markdownDescription": "%config.contextSizes.description%",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "brokeCode.maxToolSteps": {
          "type": "integer",
          "scope": "application",
          "default": 50,
          "minimum": 1,
          "markdownDescription": "%config.maxToolSteps.description%"
        },
        "brokeCode.autoApproveWrites": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "%config.autoApproveWrites.description%"
        },
        "brokeCode.commandTimeoutSeconds": {
          "type": "integer",
          "scope": "application",
          "default": 120,
          "minimum": 1,
          "markdownDescription": "%config.commandTimeoutSeconds.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "eval": "bun run eval/bench.ts",
    "lint": "bunx --bun biome check .",
    "format": "bunx --bun biome check --write .",
    "package": "bun run build && bunx --bun vsce package ${VERSION:-0.0.0} --no-update-package-json --no-git-tag-version --no-dependencies --out broke-code-${VERSION:-0.0.0}.vsix"
  },
  "dependencies": {
    "@vscode/l10n": "0.0.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.1.0",
    "ovsx": "1.3.0",
    "typescript": "7.0.2"
  }
}

{
  "name": "broke-code",
  "displayName": "broke-code",
  "description": "%extension.description%",
  "version": "0.0.0",
  "publisher": "schalappe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/schalappe/broke-code"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "broke-code",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "broke-code": [
        {
          "type": "webview",
          "id": "brokeCode.chat",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "broke-code.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "broke-code"
      }
    ],
    "configuration": {
      "title": "broke-code",
      "properties": {
        "brokeCode.providers": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "%config.providers.description%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "baseUrl"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.providers.name.description%"
              },
              "baseUrl": {
                "type": "string",
                "description": "%config.providers.baseUrl.description%"
              },
              "caFile": {
                "type": "string",
                "markdownDescription": "%config.providers.caFile.description%"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@vscode/l10n": "0.0.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.101.0",
    "typescript": "7.0.2"
  }
}
